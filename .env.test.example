# Test-only environment - copy to .env.test and fill in, or export these
# as GitHub Actions secrets for CI. Loaded ALONGSIDE the normal .env when
# running netlify dev for e2e tests (MONGODB_DB_NAME override is what
# keeps this from ever touching real data).

# Points Netlify Functions at a separate database on the same Atlas
# cluster - must end in _test, test-seed.mts refuses to run otherwise.
MONGODB_DB_NAME=eventflow_test

# Must match one of the test accounts below so approve-host-application
# (admin-gated) works from the e2e suite.
ADMIN_EMAIL=your_test_host_email_here

# Same value as VITE_FIREBASE_API_KEY in frontend/.env - needed here too
# since e2e/ authenticates directly against Firebase's REST API, outside
# the Vite-built frontend.
E2E_FIREBASE_API_KEY=your_firebase_web_api_key

# Three real Firebase Auth accounts (Email/Password) created once in the
# same Firebase project. Record each one's UID from the Firebase Console
# (Authentication -> Users) after creating it.
E2E_GUEST_EMAIL=e2e-guest@test.eventflow.dev
E2E_GUEST_PASSWORD=set_a_real_password_here

E2E_HOST_EMAIL=e2e-host@test.eventflow.dev
E2E_HOST_PASSWORD=set_a_real_password_here
E2E_HOST_FIREBASE_UID=paste_uid_from_firebase_console

E2E_PENDING_EMAIL=e2e-pending@test.eventflow.dev
E2E_PENDING_PASSWORD=set_a_real_password_here
E2E_PENDING_FIREBASE_UID=paste_uid_from_firebase_console

# Only needed if not running against the default netlify dev port.
# E2E_BASE_URL=http://localhost:8888
